# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL="file:./dev.db"

# Google Gemini API
GEMINI_API_KEY="AIzaSyDummyKey_ReplaceWithYourGoogleAIStudioKey"

# Better Auth Secret (Generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="dummy_secret_for_development_purposes_only_32chars"
BETTER_AUTH_URL="http://localhost:3080/tools/ai-interviewer"

# Google OAuth 2.0 Credentials (Optional for local dev)
GOOGLE_CLIENT_ID="dummy_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="dummy_google_client_secret"

# WebAuthn / Passkey Settings
NEXT_PUBLIC_RP_NAME="AI Interviewer"
NEXT_PUBLIC_RP_ID="localhost"

# Next.js Base Path (Subdirectory pattern)
BASE_PATH="/tools/ai-interviewer"
PORT="3080"
NODE_ENV="development"
